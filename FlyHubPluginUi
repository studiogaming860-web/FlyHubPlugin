local Comp={}
function Comp.toggle(parent,name,size,pos,on)
	local t=mk("TextButton",{Name=name,Size=size,Position=pos or UDim2.new(),Text="",AutoButtonColor=false,BorderSizePixel=0,BackgroundColor3=T.panel2},parent)
	corner(t,true); ratio(t,2)
	t:SetAttribute("LToggle",true); t:SetAttribute("LState",on and true or false); t:SetAttribute("LKind","toggle")
	local k=mk("Frame",{Name="Knob",AnchorPoint=Vector2.new(0,0.5),Size=S(0.4,0.8),Position=on and S(0.55,0.5) or S(0.05,0.5),BackgroundColor3=WHITE,BorderSizePixel=0},t)
	corner(k,true); ratio(k,1)
	return t
end
function Comp.slider(parent,name,size,pos,value)
	local tr=frame(parent,name,size,pos,"Panel2")
	corner(tr,true); tr:SetAttribute("LSlider",true); tr:SetAttribute("LValue",value)
	local fill=frame(tr,"Fill",S(value,1),nil,"Accent"); corner(fill,true)
	local knob=frame(tr,"Knob",S(0,2.2),S(value,0.5),"White")
	knob.AnchorPoint=Vector2.new(0.5,0.5); corner(knob,true); ratio(knob,1,Enum.DominantAxis.Height); stroke(knob,"AccentStroke")
	return tr
end
function Comp.bar(parent,name,size,pos,pct,label)

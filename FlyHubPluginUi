local floatOpen = true -- Status awal: UI terbuka

-- Hapus ScreenGui floating lama kalau ada (biar gak dobel)
local oldFloatHost = CoreGui:FindFirstChild("FlyHubFloating")
if oldFloatHost then oldFloatHost:Destroy() end

-- Buat ScreenGui terpisah khusus tombol floating
local floatHost = mk("ScreenGui", {
	Name = "FlyHubFloating",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	DisplayOrder = 1000,
}, (gethui and gethui()) or CoreGui)
getgenv().FlyHubFloat = floatHost

-- Tombol Floating
local floatBtn = mk("ImageButton", {
	Name = "FlyHubToggleBtn",
	Size = UDim2.fromOffset(56, 56),
	Position = UDim2.new(0, 20, 0.5, -28), -- Posisi awal: Kiri Tengah
	BackgroundColor3 = UI.panel,
	BackgroundTransparency = 0.15,
	BorderSizePixel = 0,
	Image = "rbxassetid://" .. FLOAT_IMG_ID,
	ImageColor3 = WHITE,
	ScaleType = Enum.ScaleType.Fit,
	AutoButtonColor = false,
	ZIndex = 50,
	Active = true,
}, floatHost)

mk("UICorner", {CornerRadius = UDim.new(0.5, 0)}, floatBtn)
local fbStroke = mk("UIStroke", {Color = UI.accent, Thickness = 2, Transparency = 0.3}, floatBtn)

-- Teks "FH" fallback kalau gambar gagal load
local fbText = mk("TextLabel", {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	Text = "FH",
	Font = Enum.Font.GothamBlack,
	TextSize = 20,
	TextColor3 = UI.text,
	TextTransparency = 1, -- Sembunyi default
	ZIndex = 51,
}, floatBtn)

task.delay(1, function()
	-- Kalau gambar gagal load (Image kosong), munculin teks FH
	if floatBtn.Image == "" then
		fbText.TextTransparency = 0
	end
end)

-- Efek Hover & Klik
local fbScale = mk("UIScale", {Scale = 1}, floatBtn)
floatBtn.MouseEnter:Connect(function()
	TweenService:Create(fbScale, TweenInfo.new(0.15), {Scale = 1.12}):Play()
end)
floatBtn.MouseLeave:Connect(function()
	TweenService:Create(fbScale, TweenInfo.new(0.15), {Scale = 1}):Play()
end)
floatBtn.MouseButton1Down:Connect(function()
	TweenService:Create(fbScale, TweenInfo.new(0.08), {Scale = 0.9}):Play()
end)
floatBtn.MouseButton1Up:Connect(function()
	TweenService:Create(fbScale, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.12}):Play()
end)

-- Fitur Drag untuk Tombol Floating
local fbDragging, fbDragStart, fbStartPos = false, nil, nil
floatBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		fbDragging = true
		fbDragStart = input.Position
		fbStartPos = floatBtn.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then fbDragging = false end
		end)
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if fbDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - fbDragStart
		floatBtn.Position = UDim2.new(fbStartPos.X.Scale, fbStartPos.X.Offset + delta.X, fbStartPos.Y.Scale, fbStartPos.Y.Offset + delta.Y)
	end
end)

-- FUNGSI UTAMA: Buka / Tutup Panel
local function togglePanel(open)
	-- Cegah spam klik kalau statusnya udah sama
	if open == floatOpen and mainPanel.Visible == open then return end
	floatOpen = open
	local panelScale = mainPanel:FindFirstChild("PanelScale")

	if open then
		mainPanel.Visible = true
		mainPanel.Position = UDim2.new(1, -450, 0, 60) -- Reset posisi ke kanan atas
		if panelScale then
			panelScale.Scale = 0.85
			TweenService:Create(panelScale, TweenInfo.new(0.25, Enum.EasingStyle.Back), {Scale = 1}):Play()
		end
		-- Animasi tombol memantul
		TweenService:Create(fbScale, TweenInfo.new(0.1), {Scale = 1.25}):Play()
		task.delay(0.12, function() TweenService:Create(fbScale, TweenInfo.new(0.15, Enum.EasingStyle.Back), {Scale = 1}):Play() end)
	else
		if panelScale then
			TweenService:Create(panelScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0.85}):Play()
		end
		task.delay(0.18, function()
			if not floatOpen then mainPanel.Visible = false end
		end)
	end
end

-- Klik tombol floating = Toggle
floatBtn.Activated:Connect(function()
	-- Cek kalau tombol cuma diklik (bukan di-drag jauh)
	local moved = (floatBtn.Position.X.Offset - fbStartPos.X.Offset) + (floatBtn.Position.Y.Offset - fbStartPos.Y.Offset)
	if math.abs(moved) < 10 then
		togglePanel(not floatOpen)
	end
end)



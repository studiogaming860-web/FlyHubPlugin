------------------------------------------------------------------------
local function saveFile(name, data)
    if makefolder and isfolder and not isfolder("FlyHub") then pcall(makefolder, "FlyHub") end
    if writefile then
        pcall(writefile, "FlyHub/"..name, type(data)=="table" and HttpService:JSONEncode(data) or tostring(data))
    end
end
local function loadFile(name, default)
    if isfile and isfile("FlyHub/"..name) then
        local ok, data = pcall(readfile, "FlyHub/"..name)
        if ok and data then
            local ok2, parsed = pcall(function() return HttpService:JSONDecode(data) end)
            if ok2 then return parsed end
            return data
        end
    end
    return default
end

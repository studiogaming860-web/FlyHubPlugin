local PROPS = {
	"Name","Size","Position","AnchorPoint","Rotation","BackgroundColor3","BackgroundTransparency","BorderSizePixel","Visible","ZIndex",
	"LayoutOrder","ClipsDescendants","Active","SizeConstraint",
	"Text","TextColor3","TextSize","TextScaled","TextWrapped","Font","TextXAlignment","TextYAlignment","TextTransparency",
	"TextStrokeTransparency","TextStrokeColor3","RichText","PlaceholderText","PlaceholderColor3","ClearTextOnFocus","MultiLine","AutoButtonColor",
	"Image","ImageColor3","ImageTransparency","ScaleType","ResampleMode",
	"CanvasSize","ScrollBarThickness","AutomaticCanvasSize","ScrollingDirection","ScrollBarImageColor3",
	"CornerRadius","Color","Thickness","ApplyStrokeMode","Transparency","AspectRatio","AspectType","DominantAxis","MinSize","MaxSize",
	"MinTextSize","MaxTextSize","Scale","FillDirection","HorizontalAlignment","VerticalAlignment","SortOrder","Padding","CellSize",
	"CellPadding","StartCorner","PaddingTop","PaddingBottom","PaddingLeft","PaddingRight","Offset","Enabled",
	"ResetOnSpawn","IgnoreGuiInset","ZIndexBehavior","DisplayOrder",
}
local function finite(n) return n == n and math.abs(n) ~= math.huge end

local function enc(v)
	local t = typeof(v)
	if t == "number" then if not finite(v) then return nil end; return {"number", v}
	elseif t == "string" or t == "boolean" then return {t, v}
	elseif t == "Color3" then return {"C3", v.R, v.G, v.B}
	elseif t == "UDim2" then return {"U2", v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset}
	elseif t == "UDim" then return {"U1", v.Scale, v.Offset}
	elseif t == "Vector2" then if not (finite(v.X) and finite(v.Y)) then return nil end return {"V2", v.X, v.Y}
	elseif t == "EnumItem" then return {"E", tostring(v.EnumType), v.Name}
	elseif t == "ColorSequence" then
		local k = {}; for _,kp in ipairs(v.Keypoints) do k[#k+1] = {kp.Time, kp.Value.R, kp.Value.G, kp.Value.B} end
		return {"CS", k}
	elseif t == "NumberSequence" then
		local k = {}; for _,kp in ipairs(v.Keypoints) do k[#k+1] = {kp.Time, kp.Value, kp.Envelope} end
		return {"NS", k}
	end
	return nil
end

local function dec(e)
	local t = e[1]
	if t == "number" or t == "string" or t == "boolean" then return e[2]
	elseif t == "C3" then return Color3.new(e[2], e[3], e[4])
	elseif t == "U2" then return UDim2.new(e[2], e[3], e[4], e[5])
	elseif t == "U1" then return UDim.new(e[2], e[3])
	elseif t == "V2" then return Vector2.new(e[2], e[3])
	elseif t == "E" then return Enum[e[2]][e[3]]
	elseif t == "CS" then
		local kp = {}; for _,k in ipairs(e[2]) do kp[#kp+1] = ColorSequenceKeypoint.new(k[1], Color3.new(k[2],k[3],k[4])) end
		return ColorSequence.new(kp)
	elseif t == "NS" then
		local kp = {}; for _,k in ipairs(e[2]) do kp[#kp+1] = NumberSequenceKeypoint.new(k[1], k[2], k[3]) end
		return NumberSequence.new(kp)
	end
	return nil
end

local defaults = {}
local function getDefault(class)
	if defaults[class] == nil then
		local ok, o = pcall(Instance.new, class)
		defaults[class] = ok and o or false
	end
	return defaults[class]
end

local function serialize(inst)
	local node = {c = inst.ClassName, p = {}, a = {}, k = {}}
	local def = getDefault(inst.ClassName)
	for _, prop in ipairs(PROPS) do
		local ok, v = pcall(function() return inst[prop] end)
		if ok then
			local e = enc(v)
			if e then
				local same = false
				if def then
					local ok2, dv = pcall(function() return def[prop] end)
					if ok2 then
						local de = enc(dv)
						same = de ~= nil and HttpService:JSONEncode(de) == HttpService:JSONEncode(e)
					end
				end
				if prop == "Name" or not same then node.p[prop] = e end
			end
		end
	end
	for k,v in pairs(inst:GetAttributes()) do
		local e = enc(v)
		if e then node.a[k] = e end
	end
	for _, ch in ipairs(inst:GetChildren()) do
		if ch:IsA("GuiBase2d") or ch:IsA("UIComponent") then node.k[#node.k+1] = serialize(ch) end
	end
	return node
end

local function deserialize(node, parent)
	local o = Instance.new(node.c)
	for prop, e in pairs(node.p) do pcall(function() o[prop] = dec(e) end) end
	for k, e in pairs(node.a) do local v = dec(e) if v ~= nil then o:SetAttribute(k, v) end end
	for _, ch in ipairs(node.k) do deserialize(ch, o) end
	o.Parent = parent
	return o
end


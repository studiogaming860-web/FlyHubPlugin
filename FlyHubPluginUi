	end
end

if oldCloseBtn then
	oldCloseBtn:Destroy()
	local newClose = mk("TextButton", {
		Size = UDim2.fromOffset(24, 24),
		Position = UDim2.new(1, -30, 0, 16),
		BackgroundColor3 = UI.bad,
		BorderSizePixel = 0,
		Text = "✕",
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = WHITE,
		AutoButtonColor = false,
	}, header)
	mk("UICorner", {CornerRadius = UDim.new(0,6)}, newClose)
	newClose.Activated:Connect(function()
		togglePanel(false) -- Sembunyikan UI
	end)
end

if setStatus then
	setStatus("💡 UI bisa digeser bebas. Ikon kiri layar untuk buka/tutup.", false)
end

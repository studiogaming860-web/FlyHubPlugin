local function makeResponsive(roots)
	local n = 0
	for _, o in ipairs(collect(roots)) do
		if o:IsA("LayerCollector") then
			pcall(function() o.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets end)
			if o:IsA("ScreenGui") then o.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end
		elseif o:IsA("GuiObject") then
			local par = o.Parent
			local ps = Vector2.zero
			if par and (par:IsA("GuiObject") or par:IsA("LayerCollector")) then ps = par.AbsoluteSize end
			if ps.X > 0 and ps.Y > 0 then
				local hasLayout = par:FindFirstChildWhichIsA("UIGridLayout") ~= nil or par:FindFirstChildWhichIsA("UIListLayout") ~= nil
				local s, p = o.Size, o.Position
				if s.X.Offset ~= 0 or s.Y.Offset ~= 0 then
					o.Size = UDim2.fromScale(s.X.Scale + s.X.Offset/ps.X, s.Y.Scale + s.Y.Offset/ps.Y); n += 1
				end
				if not hasLayout and (p.X.Offset ~= 0 or p.Y.Offset ~= 0) then
					o.Position = UDim2.fromScale(p.X.Scale + p.X.Offset/ps.X, p.Y.Scale + p.Y.Offset/ps.Y)
				end
			end
			if (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) and o.TextScaled and not o:FindFirstChildWhichIsA("UITextSizeConstraint") then
				mk("UITextSizeConstraint", {MaxTextSize=40, MinTextSize=8}, o); n += 1
			end
			if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and not o:FindFirstChildWhichIsA("UIAspectRatioConstraint") and o.AbsoluteSize.X > 0 and o.AbsoluteSize.Y > 0 then
				mk("UIAspectRatioConstraint", {AspectRatio=o.AbsoluteSize.X/o.AbsoluteSize.Y}, o); n += 1
			end
		end
	end
	return n
end

local function lint(roots)
	local offset, textNo, imgNo, outside, total = 0,0,0,0,0
	local gs = {}
	for _, o in ipairs(collect(roots)) do
		if o:IsA("LayerCollector") then gs[#gs+1] = o
		elseif o:IsA("GuiObject") then
			total += 1
			local s = o.Size
			if s.X.Offset ~= 0 or s.Y.Offset ~= 0 then offset += 1 end
			if (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) and o.TextScaled and not o:FindFirstChildWhichIsA("UITextSizeConstraint") then textNo += 1 end
			if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and not o:FindFirstChildWhichIsA("UIAspectRatioConstraint") then imgNo += 1 end
			local par = o.Parent
			if par and par:IsA("GuiObject") and not par:IsA("ScrollingFrame") and not par:FindFirstChildWhichIsA("UIListLayout") and not par:FindFirstChildWhichIsA("UIGridLayout") then
				local pa, ps, oa, os = par.AbsolutePosition, par.AbsoluteSize, o.AbsolutePosition, o.AbsoluteSize
				if oa.X < pa.X-2 or oa.Y < pa.Y-2 or oa.X+os.X > pa.X+ps.X+2 or oa.Y+os.Y > pa.Y+ps.Y+2 then outside += 1 end
			end
		end
	end
	local function line(bad, okMsg, badMsg) return (bad > 0 and "⚠ "..badMsg:format(bad) or "✔ "..okMsg) end
	local out = {

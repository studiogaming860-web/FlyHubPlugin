local function detectMime(bytes)
	if #bytes > 4 and bytes:byte(1)==137 and bytes:byte(2)==80 and bytes:byte(3)==78 and bytes:byte(4)==71 then return "image/png","png" end
	if #bytes > 3 and bytes:byte(1)==255 and bytes:byte(2)==216 and bytes:byte(3)==255 then return "image/jpeg","jpg" end
	return nil
end

local function uploadImage(bytes, name)
	local key = loadFile("apikey.txt", "")
	local cid = loadFile("creatorid.txt", "")
	local ctype = loadFile("creatortype.txt", "User")
	if key == "" or cid == "" then return nil, "Isi API Key & Creator ID di tab Setelan" end
	local mime, ext = detectMime(bytes)
	if not mime then return nil, "Format harus PNG atau JPG" end
	local creator = (ctype == "Group") and {groupId=tostring(cid)} or {userId=tostring(cid)}
	local req = HttpService:JSONEncode({assetType="Decal", displayName=tostring(name):sub(1,50), description="FlyHub upload", creationContext={creator=creator}})
	local boundary = "FLYHUB"..(HttpService:GenerateGUID(false):gsub("-",""))
	local body = "--"..boundary.."\r\nContent-Disposition: form-data; name=\"request\"\r\nContent-Type: application/json\r\n\r\n"..req
		.."\r\n--"..boundary.."\r\nContent-Disposition: form-data; name=\"fileContent\"; filename=\"upload."..ext.."\"\r\nContent-Type: "..mime.."\r\n\r\n"
		..bytes.."\r\n--"..boundary.."--\r\n"
	local ok, res = pcall(function()
		return HttpService:RequestAsync({Url="https://apis.roblox.com/assets/v1/assets", Method="POST",
			Headers={["x-api-key"]=key, ["Content-Type"]="multipart/form-data; boundary="..boundary}, Body=body})
	end)
	if not ok then return nil, tostring(res) end
	if not res.Success then return nil, "HTTP "..res.StatusCode..": "..tostring(res.Body):sub(1,140) end
	local data = HttpService:JSONDecode(res.Body)
	local opPath = data.path
	for _=1,30 do
		if data.done or not opPath then break end
		task.wait(1.5)
		local ok2, r2 = pcall(function()
			return HttpService:RequestAsync({Url="https://apis.roblox.com/assets/v1/"..opPath, Method="GET", Headers={["x-api-key"]=key}})
		end)
		if ok2 and r2.Success then data = HttpService:JSONDecode(r2.Body) end
	end
	if data.done and data.response and data.response.assetId then return tostring(data.response.assetId) end
	if data.done and data.error then return nil, tostring(data.error.message or "Upload ditolak") end
	return nil, "Timeout / sedang dimoderasi"
end


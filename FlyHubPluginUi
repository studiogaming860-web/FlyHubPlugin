local function S(x,y) return UDim2.fromScale(x,y) end
local function mk(class, props, parent)
	local o = Instance.new(class)
	for k,v in pairs(props) do o[k]=v end
	if parent then o.Parent=parent end
	return o
end
local function uid() return HttpService:GenerateGUID(false):sub(1,6) end

local function applyOne(o)
	local role = o:GetAttribute("LRole")
	if role then
		if o:IsA("GuiObject") then
			if role=="Bg" then o.BackgroundColor3=T.bg
			elseif role=="Panel" then o.BackgroundColor3=T.panel; o.BackgroundTransparency=T.pt
			elseif role=="Panel2" then o.BackgroundColor3=T.panel2; o.BackgroundTransparency=T.pt
			elseif role=="Accent" then o.BackgroundColor3=T.accent
			elseif role=="Accent2" then o.BackgroundColor3=T.accent2
			elseif role=="Good" then o.BackgroundColor3=T.good
			elseif role=="Bad" then o.BackgroundColor3=T.bad
			elseif role=="White" then o.BackgroundColor3=WHITE end
		elseif o:IsA("UIStroke") then
			if role=="Stroke" then o.Color=T.stroke; o.Thickness=T.thick
			elseif role=="AccentStroke" then o.Color=T.accent; o.Thickness=T.thick end
		elseif o:IsA("UICorner") then
			if role=="Corner" then o.CornerRadius=UDim.new(0,T.radius) end
		elseif o:IsA("UIGradient") then
			if role=="Grad" then o.Color=ColorSequence.new(T.accent,T.accent2) end
		end
	end
	local tr=o:GetAttribute("LText")
	if tr and (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) then
		if tr=="Sub" then o.TextColor3=T.sub
		elseif tr=="Accent" then o.TextColor3=T.accent
		elseif tr=="Good" then o.TextColor3=T.good
		elseif tr=="Bad" then o.TextColor3=T.bad
		elseif tr=="White" then o.TextColor3=WHITE
		elseif tr=="Dark" then o.TextColor3=C(20,20,30)
		else o.TextColor3=T.text end
		o.Font=T.font
	end
	local kind=o:GetAttribute("LKind")
	if kind=="toggle" then
		o:SetAttribute("LOn",T.good); o:SetAttribute("LOff",T.panel2)
		o.BackgroundColor3=(o:GetAttribute("LState")==true) and T.good or T.panel2
	elseif kind=="tab" then
		o:SetAttribute("LOn",T.accent); o:SetAttribute("LOff",T.panel2)
		o.BackgroundColor3=(o:GetAttribute("LActive")==true) and T.accent or T.panel2
	end
end
local function applyTheme(root)
	applyOne(root)
	for _,d in ipairs(root:GetDescendants()) do applyOne(d) end
end
local function corner(p,full)
	local c=mk("UICorner",{CornerRadius=full and UDim.new(0.5,0) or UDim.new(0,T.radius)},p)
	if not full then c:SetAttribute("LRole","Corner") end
	return c
end
local function stroke(p,role)
	local s=mk("UIStroke",{ApplyStrokeMode=Enum.ApplyStrokeMode.Border, Color=T.stroke, Thickness=T.thick},p)
	s:SetAttribute("LRole",role or "Stroke")
	return s
end
local function ratio(p,r,dom) return mk("UIAspectRatioConstraint",{AspectRatio=r,DominantAxis=dom or Enum.DominantAxis.Width},p) end
local function list(p,horizontal,pad,align)
	return mk("UIListLayout",{
		FillDirection=horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Padding=UDim.new(pad or 0.02,0),
		SortOrder=Enum.SortOrder.LayoutOrder,
		HorizontalAlignment=align or Enum.HorizontalAlignment.Left,
	},p)
end
local function frame(parent,name,size,pos,role)
	local f=mk("Frame",{Name=name,Size=size,Position=pos or UDim2.new(),BorderSizePixel=0,BackgroundColor3=T.panel},parent)
	if role then f:SetAttribute("LRole",role) else f.BackgroundTransparency=1 end

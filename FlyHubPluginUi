	local function addResult(id, name, cat)
		resultCount += 1
		local cell = mk("Frame", {BackgroundColor3=UI.panel, BorderSizePixel=0, LayoutOrder=resultCount}, results)
		mk("UICorner", {CornerRadius=UDim.new(0,8)}, cell)
		local img = mk("ImageButton", {Size=UDim2.new(1,-8,1,-34), Position=UDim2.fromOffset(4,4),
			BackgroundColor3=UI.panel2, BorderSizePixel=0,
			Image=("rbxthumb://type=Asset&id=%d&w=150&h=150"):format(id),
			ScaleType=Enum.ScaleType.Fit}, cell)
		mk("UICorner", {CornerRadius=UDim.new(0,6)}, img)
		mk("TextLabel", {Size=UDim2.new(1,-8,0,26), Position=UDim2.new(0,4,1,-28), BackgroundTransparency=1,
			Text=name, TextColor3=UI.text, Font=Enum.Font.Gotham, TextSize=10,
			TextWrapped=true, TextTruncate=Enum.TextTruncate.AtEnd}, cell)
		img.Activated:Connect(function()
			setStatus("⏳ Memasukkan "..name.."...", false)
			if cat == 13 then
				local ok, res = record("Decal Store", function() addImage(tostring(id)) end)
				setStatus(ok and ("✔ "..name) or ("✖ "..tostring(res)), not ok)
			else
				local ok, res = record("Store Model", function() insertModelAsset(id) end)
				setStatus(ok and ("✔ "..name) or ("✖ "..tostring(res)), not ok)
			end
		end)
	end
	local function runSearch(reset)
		if reset then
			storePage = 0; resultCount = 0
			for _, c in ipairs(results:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
		end
		setStatus("⏳ Mencari...", false)
		local cat = storeCat
		local url = ("https://apis.roblox.com/toolbox-service/v1/marketplace/%d?keyword=%s&pageNumber=%d"):format(cat, HttpService:UrlEncode(kw.Text), storePage)
		local ok, res = pcall(function() return HttpService:RequestAsync({Url=url, Method="GET"}) end)
		if not ok then setStatus("✖ Aktifkan izin HTTP", true); return end
		if not res.Success then setStatus("✖ Pencarian gagal (HTTP "..res.StatusCode..")", true); return end
		local okd, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
		local ids = {}
		if okd and type(data.data) == "table" then
			for _, it in ipairs(data.data) do ids[#ids+1] = it.id end
		end
		if #ids == 0 then setStatus("Tidak ada hasil", true); return end
		local names = {}
		local ok2, r2 = pcall(function()
			return HttpService:RequestAsync({Url="https://apis.roblox.com/toolbox-service/v1/items/details?assetIds="..table.concat(ids, "%2C"), Method="GET"})
		end)
		if ok2 and r2.Success then
			local okd2, d2 = pcall(function() return HttpService:JSONDecode(r2.Body) end)
			if okd2 and type(d2.data) == "table" then
				for _, it in ipairs(d2.data) do if it.asset then names[it.asset.id] = it.asset.name end end
			end
		end
		for _, id in ipairs(ids) do addResult(id, names[id] or tostring(id), cat) end
		setStatus("✔ "..#ids.." hasil (hal "..(storePage+1)..")", false)
	end
	uiButton(pg, "🔍 Cari di Creator Store", function() runSearch(true) end, UI.accent)
